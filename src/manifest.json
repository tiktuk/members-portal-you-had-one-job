{
  "manifest_version": 3,
  "name": "Members portal, you had one job",
  "short_name": "One job",
  "version": "1.0.2",
  "description": "Adds resource filters and pinned single-resource calendars to the MotionLab.Berlin portal, so booking a machine takes one click.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": [
    "https://motionlabberlin.spaces.nexudus.com/*",
    "https://api.luma.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Members portal, you had one job",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://members.motionlab.berlin/*"],
      "js": [
        "lib/config.js",
        "lib/url.js",
        "lib/groups.js",
        "lib/overview.js",
        "lib/overview-view.js",
        "content.js"
      ],
      "css": ["portal.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/config.js", "lib/url.js", "page.js", "overview.html", "overview.css"],
      "matches": ["https://members.motionlab.berlin/*"]
    }
  ]
}
